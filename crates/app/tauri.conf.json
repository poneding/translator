{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translator",
  "version": "0.2.0",
  "identifier": "dev.translator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMkFBQjBGMjFBMUEyNzQKUldSMG9xRWhENnNxUTZWMXVGbUg5ZFZMZ1FRNG1UcUJEaEtHUTVKUldmRzB6NWw2aUxDVE1zR1cK",
      "endpoints": [
        "https://github.com/poneding/translator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Translator",
        "url": "index.html",
        "width": 680,
        "height": 560,
        "minWidth": 680,
        "minHeight": 560,
        "maxWidth": 920,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "devtools": true,
        "visible": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Cross-platform select-and-translate tool",
    "longDescription": "Pick text anywhere, press a hotkey, get translations in the main window. Supports Youdao, DeepL, Google, Bing, and any OpenAI-compatible API.",
    "publisher": "translator contributors",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "frameworks": []
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
